[layer_names]

2d_physics/layer_1="enemy_hitbox"
2d_physics/layer_2="walls"
2d_physics/layer_3="static_objects"
2d_physics/layer_4="enemy_collision"
2d_physics/layer_5="player_collision"
2d_physics/layer_6="bullet_hurtbox"
2d_physics/layer_7="player_hitbox"
2d_physics/layer_8="health_pickup"
